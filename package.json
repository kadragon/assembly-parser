{
  "name": "assembly-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser app that summarizes live National Assembly AI captions or uploaded JSONL, SRT, and WebVTT transcripts by time window and interest category",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "demo": "node src/demo.js",
    "collect": "node src/collect.js",
    "summarize": "node src/summarize.js",
    "serve": "node src/serve.js",
    "test": "node --test",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
